!define MUI_LICENSEPAGE_TEXT_BOTTOM "If you accept the terms and conditions, click 'I Agree' to continue. Otherwise, click 'Cancel' to exit the setup."
!define MUI_LICENSEPAGE_BUTTON "I &Agree"
