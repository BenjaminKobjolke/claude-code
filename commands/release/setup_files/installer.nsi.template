; {{APP_NAME}} Installer Script (NSIS + Modern UI 2)
; Template placeholders to fill per project:
;   {{APP_NAME}}     - display name (window title via Name); also install dir, registry key, Start Menu folder
;   {{PAYLOAD_PATH}} - File /r source, relative to installer/ (e.g. ../dist/myapp/myapp/*.*)
;   {{OUTFILE}}      - output path, relative to installer/ (e.g. ../releases/windows/installer.exe)
;   {{MAIN_EXE}}     - main exe name for the Start Menu launch shortcut

!include "MUI2.nsh"
!include "FileFunc.nsh"
!include "LogicLib.nsh"

; Installer settings
Name "{{APP_NAME}}"
Outfile "{{OUTFILE}}"
InstallDir $PROGRAMFILES\{{APP_NAME}}
RequestExecutionLevel admin
ShowInstDetails show

; Default installation section
Section "{{APP_NAME}} (required)"

  SetOutPath $INSTDIR
  File /r "{{PAYLOAD_PATH}}"

  ; Write the installation path into the registry
  WriteRegStr HKLM "Software\{{APP_NAME}}" "Install_Dir" $INSTDIR

  ; Create the uninstaller
  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; Create shortcuts in the Start Menu Programs folder
  CreateDirectory $SMPROGRAMS\{{APP_NAME}}
  CreateShortCut "$SMPROGRAMS\{{APP_NAME}}\{{APP_NAME}}.lnk" "$INSTDIR\{{MAIN_EXE}}"
  CreateShortCut "$SMPROGRAMS\{{APP_NAME}}\Uninstall.lnk" "$INSTDIR\Uninstall.exe"

SectionEnd

; Uninstaller settings
Section "Uninstall"

  ; Remove the registry entries
  DeleteRegKey HKLM "Software\{{APP_NAME}}"

  ; Remove the Start Menu shortcuts
  Delete "$SMPROGRAMS\{{APP_NAME}}\{{APP_NAME}}.lnk"
  Delete "$SMPROGRAMS\{{APP_NAME}}\Uninstall.lnk"
  RMDir "$SMPROGRAMS\{{APP_NAME}}"

  ; Remove the installed files
  RMDir /r "$INSTDIR"

SectionEnd

; Modern User Interface settings
!define MUI_WELCOMEPAGE_TITLE "Welcome to the {{APP_NAME}} Setup Wizard"
!define MUI_WELCOMEPAGE_TEXT "This wizard will guide you through the installation of {{APP_NAME}}.$\r$\n$\r$\nClick Next to continue or Cancel to exit the setup."
!insertmacro MUI_PAGE_WELCOME
