"""Check release version handoff with isolated builds and a fake publisher."""

import os
from pathlib import Path
import shutil
import subprocess
import tempfile


TOOLS = Path(__file__).resolve().parent


def run_batch(path, *args):
    result = subprocess.run(
        ["cmd", "/d", "/c", "call", str(path), *args],
        capture_output=True, text=True, timeout=30,
    )
    return result


def check_release_version():
    with tempfile.TemporaryDirectory(prefix="release-version-") as temporary:
        root = Path(temporary)
        scripts = root / "tools"
        releases = root / "releases" / "windows"
        fake_tool = root / "release-tool"
        notes = root / "assets" / "release-notes" / "504"
        for directory in (scripts, releases, fake_tool, notes):
            directory.mkdir(parents=True)
        pubspec = root / "pubspec.yaml"
        pubspec.write_text("version: 1.0.0+503\n", encoding="utf-8")
        (notes / "en.json").write_text("{}", encoding="utf-8")
        (notes / "de.json").write_text("{}", encoding="utf-8")
        (scripts / "previous_version.txt").write_text("1.0.0_503\n")
        (fake_tool / "uv.cmd").write_text("@echo off\nexit /b 7\n")
        shutil.copyfile(TOOLS / "build_release.bat", scripts / "build_release.bat")
        stubs = {
            "build_number_increment.bat": '>%~dp0..\\pubspec.yaml echo version: 1.0.0+504\n',
            "translator_app-release-notes.bat": "",
            "build_appbundle_release.bat": (
                'mkdir "%~dp0..\\build\\app\\outputs\\bundle\\release"\n'
                '>"%~dp0..\\build\\app\\outputs\\bundle\\release\\app-release.aab" echo bundle\n'
            ),
            "build_windows_release.bat": (
                '>"%~dp0..\\releases\\windows\\TurboHabits_v1.0.0_504.exe" echo installer504\n'
            ),
        }
        for name, body in stubs.items():
            (scripts / name).write_text("@echo off\n" + body + "exit /b 0\n")
        (scripts / "update_release_notes_assets.py").write_text("raise SystemExit(0)\n")
        publisher = (TOOLS / "publish_release.bat").read_text()
        publisher = publisher.replace(
            "D:\\GIT\\BenjaminKobjolke\\release-tool", str(fake_tool)
        )
        (scripts / "publish_release.bat").write_text(publisher)
        previous_path = os.environ.get("PATH", "")
        os.environ["PATH"] = str(fake_tool) + os.pathsep + previous_path
        try:
            result = run_batch(scripts / "build_release.bat")
            assert result.returncode == 0, result.stdout + result.stderr
            marker = releases / "release_version.txt"
            assert marker.read_text().strip() == "1.0.0_504", "Build must record its label"

            pubspec.write_text("version: 1.0.0+503\n", encoding="utf-8")
            (scripts / "build_appbundle_release.bat").write_text("@echo off\nexit /b 1\n")
            result = run_batch(scripts / "build_release.bat")
            assert result.returncode == 1, result.stdout + result.stderr
            assert "1.0.0+503" in pubspec.read_text(), "Failed builds must roll back"
            assert marker.read_text().strip() == "1.0.0_504", "Failed builds must keep the last release"
            assert not (root / "build" / "release-build.lock").exists()

            # A later APK build can advance pubspec without rebuilding Windows.
            pubspec.write_text("version: 1.0.0+505\n", encoding="utf-8")
            result = run_batch(scripts / "publish_release.bat")
            assert "Publishing 1.0.0_504" in result.stdout, result.stdout + result.stderr
            assert (releases / "TurboHabits.exe").read_bytes() == (
                releases / "TurboHabits_v1.0.0_504.exe"
            ).read_bytes()
            assert result.returncode == 7, "Publisher must preserve upload failures"
            assert "1.0.0+505" in pubspec.read_text(), "Publishing must not change source version"

            # Older builds can be selected explicitly without a marker.
            marker.unlink()
            result = run_batch(scripts / "publish_release.bat", "1.0.0_503", "1.0.0_504")
            assert "Publishing 1.0.0_504" in result.stdout, result.stdout + result.stderr
            assert result.returncode == 7, result.stdout + result.stderr
            result = run_batch(scripts / "publish_release.bat")
            assert result.returncode == 1, "Missing build record must stop publishing"

            launcher = (TOOLS / "release_create.bat").read_text().replace(
                "D:\\GIT\\BenjaminKobjolke\\release-tool", str(fake_tool)
            )
            (scripts / "release_create.bat").write_text(launcher)
            result = run_batch(scripts / "release_create.bat", "--dry-run")
            assert result.returncode == 7, "Release launcher must preserve failures"

            android = root / "android"
            android.mkdir()
            bundle_dir = root / "build" / "app" / "outputs" / "bundle" / "release"
            (fake_tool / "fvm.cmd").write_text(
                '@echo off\n>"android\\local.properties" echo flutter.versionCode=504\n'
                '>"build\\app\\outputs\\bundle\\release\\app-release.aab" echo bundle504\n'
                'exit /b 0\n'
            )
            shutil.copyfile(TOOLS / "build_appbundle_release.bat", scripts / "build_appbundle_release.bat")
            result = run_batch(scripts / "build_appbundle_release.bat")
            assert result.returncode == 0, result.stdout + result.stderr
            bundle_version = bundle_dir / "app-release.properties"
            assert "flutter.versionCode=504" in bundle_version.read_text()

            (android / "local.properties").write_text("flutter.versionCode=505\n")
            (fake_tool / "uv.cmd").write_text('@echo off\necho %*\nexit /b 7\n')
            android_publisher = (TOOLS / "upload_apppundle_to_play_store.bat").read_text().replace(
                "D:\\GIT\\BenjaminKobjolke\\google-play-app-updater", str(fake_tool)
            )
            (scripts / "upload_apppundle_to_play_store.bat").write_text(android_publisher)
            result = run_batch(scripts / "upload_apppundle_to_play_store.bat")
            upload_output = result.stdout.replace(str(scripts / ".."), str(root))
            assert str(bundle_version) in upload_output, result.stdout + result.stderr
            assert "local.properties" not in result.stdout, "Upload must use the bundle snapshot"
            assert result.returncode == 7, "Android uploader must preserve failures"
            assert "flutter.versionCode=504" in bundle_version.read_text()
            assert "flutter.versionCode=505" in (android / "local.properties").read_text()

            bundle_version.unlink()
            result = run_batch(scripts / "upload_apppundle_to_play_store.bat")
            assert result.returncode == 1, "Missing bundle metadata must stop upload"

            bundle_version.write_text("flutter.versionCode=504\n")
            (fake_tool / "fvm.cmd").write_text("@echo off\nexit /b 1\n")
            result = run_batch(scripts / "build_appbundle_release.bat")
            assert result.returncode == 1, "AAB build failures must propagate"
            assert not bundle_version.exists(), "Failed AAB builds must invalidate old metadata"
            (bundle_dir / "app-release.aab").unlink()
            result = run_batch(scripts / "upload_apppundle_to_play_store.bat")
            assert result.returncode == 1, "Missing AAB must stop upload"
        finally:
            os.environ["PATH"] = previous_path


if __name__ == "__main__":
    check_release_version()
    print("Release version handoff checks passed.")
